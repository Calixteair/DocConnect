{% extends 'base.html.twig' %}

{% block title %}DocConnect — prise de rendez-vous médicaux{% endblock %}

{% block body %}
    {# ============================ Hero ============================ #}
    <section class="hero" aria-labelledby="hero-title">
        <div class="container hero__inner">
            <h1 id="hero-title" class="hero__title">
                Trouvez votre médecin, prenez rendez-vous.
            </h1>
            <p class="hero__subtitle">
                Annuaire de praticiens tunisiens en cabinet ou en téléconsultation.
            </p>

            {% include 'components/_search_bar.html.twig' with {
                specialties: specialties,
                specialty: '',
                city: '',
                size: 'hero',
            } only %}

            <p class="hero__microcopy">
                Cabinet ou téléconsultation. Sans inscription pour rechercher.
            </p>
        </div>
    </section>

    {# ======================== Comment ça marche ==================== #}
    <section class="section section--white" aria-labelledby="steps-title">
        <div class="container">
            <h2 id="steps-title" class="section__title">Comment ça marche</h2>

            <ol class="steps">
                <li class="step">
                    <div class="step__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    </div>
                    <h3 class="step__title">Cherchez</h3>
                    <p class="step__desc">
                        Un spécialiste près de chez vous, filtré par spécialité ou par mode de consultation.
                    </p>
                </li>

                <li class="step">
                    <div class="step__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
                    </div>
                    <h3 class="step__title">Réservez</h3>
                    <p class="step__desc">
                        En quelques clics, un créneau qui vous convient. Confirmation immédiate par mail.
                    </p>
                </li>

                <li class="step">
                    <div class="step__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/></svg>
                    </div>
                    <h3 class="step__title">Consultez</h3>
                    <p class="step__desc">
                        Sereinement, en cabinet ou en visio. Rappel par mail 24 h avant.
                    </p>
                </li>
            </ol>
        </div>
    </section>

    {# ======================== Spécialités ============================ #}
    <section class="section section--bg" aria-labelledby="specialties-title">
        <div class="container">
            <h2 id="specialties-title" class="section__title">Spécialités les plus demandées</h2>

            <ul class="chips">
                {% for s in specialties %}
                    <li>
                        <a class="chip" href="{{ path('app_doctor_search', { specialty: s.slug }) }}">{{ s.label }}</a>
                    </li>
                {% endfor %}
                <li>
                    <a class="chip chip--ghost" href="{{ path('app_doctor_search') }}">
                        Voir toutes les spécialités
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </li>
            </ul>
        </div>
    </section>

    {# ======================== Témoignages ============================ #}
    <section class="section section--white" aria-labelledby="testimonials-title">
        <div class="container">
            <h2 id="testimonials-title" class="section__title">Ils nous font confiance</h2>

            <div class="testimonials">
                <figure class="testimonial">
                    <blockquote>« RDV pris en 2 minutes, super pratique pour une urgence dermato. »</blockquote>
                    <figcaption>Salma, 34 ans</figcaption>
                </figure>

                <figure class="testimonial">
                    <blockquote>« Très simple à utiliser, je recommande à mes parents. »</blockquote>
                    <figcaption>Mohamed-Ali, 58 ans</figcaption>
                </figure>

                <figure class="testimonial">
                    <blockquote>« Le rappel par mail la veille est top, je n'oublie plus aucun RDV. »</blockquote>
                    <figcaption>Ines, 27 ans</figcaption>
                </figure>
            </div>
        </div>
    </section>
{% endblock %}
