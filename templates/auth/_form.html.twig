{# Form auth réutilisable : signup montre firstName/lastName, login non. #}
<form
    method="post"
    class="auth-form"
    data-controller="auth"
    data-auth-mode-value="{{ mode }}"
    data-auth-api-key-value="{{ firebase_api_key }}"
    data-auth-auth-domain-value="{{ firebase_auth_domain }}"
    data-auth-project-id-value="{{ firebase_project_id }}"
    data-auth-app-id-value="{{ firebase_app_id }}"
    data-action="submit->auth#submit"
    novalidate
>
    {% if mode == 'signup' %}
        <div class="field-row">
            <div class="field">
                <label for="firstName" class="field__label">Prénom</label>
                <input id="firstName" name="firstName" type="text" required minlength="1" maxlength="80" autocomplete="given-name" class="field__input">
            </div>
            <div class="field">
                <label for="lastName" class="field__label">Nom</label>
                <input id="lastName" name="lastName" type="text" required minlength="1" maxlength="80" autocomplete="family-name" class="field__input">
            </div>
        </div>
    {% endif %}

    <div class="field">
        <label for="email" class="field__label">Adresse e-mail</label>
        <input id="email" name="email" type="email" required autocomplete="email" class="field__input" placeholder="vous@exemple.tn">
    </div>

    <div class="field">
        <label for="password" class="field__label">Mot de passe</label>
        <input id="password" name="password" type="password" required minlength="6" autocomplete="{{ mode == 'signup' ? 'new-password' : 'current-password' }}" class="field__input">
        <p class="field__hint">{{ mode == 'signup' ? '6 caractères minimum.' : '' }}</p>
    </div>

    <p class="auth-form__error" role="alert" hidden data-auth-target="error"></p>

    <button type="submit" class="btn btn--primary btn--lg auth-form__submit" data-auth-target="submit">
        {{ mode == 'signup' ? 'Créer mon compte' : 'Se connecter' }}
    </button>
</form>
