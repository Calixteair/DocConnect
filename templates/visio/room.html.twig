<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Téléconsultation · DocConnect</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body class="visio-body">
    <main class="visio-layout">
        <aside class="visio-sidebar">
            <a href="{{ path('app_my_appointments') }}" class="brand" aria-label="DocConnect — Mes RDV">
                <span class="brand__mark" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/></svg>
                </span>
                <span>DocConnect</span>
            </a>

            <div class="visio-sidebar__info">
                <p class="visio-sidebar__label">Téléconsultation</p>
                <h1 class="visio-sidebar__doctor">{{ appointment.slot.doctor.displayName }}</h1>
                <p class="visio-sidebar__time">
                    {{ appointment.slot.startAt|format_datetime(pattern='EEEE d MMMM', locale='fr')|capitalize }}
                    à {{ appointment.slot.startAt|date('H:i') }}
                </p>

                {% if appointment.motif %}
                    <section class="visio-sidebar__block">
                        <h2>Motif</h2>
                        <p>{{ appointment.motif }}</p>
                    </section>
                {% endif %}

                <section class="visio-sidebar__block">
                    <h2>Conseils</h2>
                    <ul>
                        <li>Activez votre micro et votre caméra.</li>
                        <li>Préparez vos questions et derniers examens.</li>
                        <li>Choisissez un endroit calme et bien éclairé.</li>
                    </ul>
                </section>
            </div>

            <a href="{{ path('app_my_appointments') }}" class="btn btn--danger-solid visio-sidebar__hangup">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"/><line x1="22" x2="2" y1="2" y2="22"/></svg>
                Raccrocher
            </a>
        </aside>

        <section class="visio-stage" aria-label="Flux vidéo">
            <iframe
                src="https://meet.jit.si/{{ room }}#userInfo.displayName=&quot;{{ app.user.fullName|e('js') }}&quot;&config.prejoinPageEnabled=false&config.disableDeepLinking=true"
                allow="camera; microphone; fullscreen; display-capture; autoplay"
                allowfullscreen
                class="visio-iframe"
                title="Téléconsultation Jitsi"
            ></iframe>
        </section>
    </main>
</body>
</html>
