{% extends 'base.html.twig' %}

{% block body %}
<section class="admin-shell">
    <aside class="admin-sidebar" aria-label="Navigation administration">
        <div class="admin-sidebar__brand">Administration</div>
        <nav class="admin-sidebar__nav">
            <a href="{{ path('app_admin_home') }}" class="admin-sidebar__link{{ app.request.attributes.get('_route') == 'app_admin_home' ? ' is-active' : '' }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                Tableau de bord
            </a>
            <a href="{{ path('app_admin_users') }}" class="admin-sidebar__link{{ app.request.attributes.get('_route') starts with 'app_admin_user' ? ' is-active' : '' }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Utilisateurs
            </a>
        </nav>
        <a href="{{ path('app_home') }}" class="admin-sidebar__back">← Retour au site</a>
    </aside>

    <div class="admin-main">
        {% for label, messages in app.flashes(['success', 'error']) %}
            {% for msg in messages %}
                <div class="alert alert--{{ label }}" role="status">{{ msg }}</div>
            {% endfor %}
        {% endfor %}

        {% block admin_content %}{% endblock %}
    </div>
</section>
{% endblock %}
