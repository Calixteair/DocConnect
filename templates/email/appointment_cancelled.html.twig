{% extends 'email/_base.html.twig' %}

{% block subject %}Rendez-vous annulé — {{ doctor.displayName }}{% endblock %}

{% block content %}
    <h1 style="margin: 0 0 16px; font-size: 24px; font-weight: 600; color: #1F2937;">Rendez-vous annulé</h1>

    <p style="margin: 0 0 24px; color: #1F2937;">
        Bonjour {{ recipient.firstName }},<br>
        Le rendez-vous suivant a été annulé.
    </p>

    <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px; padding: 16px; margin-bottom: 24px;">
        <tr>
            <td style="padding: 8px 16px; color: #6B7280; font-size: 14px; width: 100px;">Médecin</td>
            <td style="padding: 8px 16px; color: #1F2937; font-weight: 500;">{{ doctor.displayName }}</td>
        </tr>
        <tr>
            <td style="padding: 8px 16px; color: #6B7280; font-size: 14px;">Date initiale</td>
            <td style="padding: 8px 16px; color: #1F2937; font-weight: 500;">{{ slot.startAt|format_datetime(pattern='EEEE d MMMM y à HH:mm', locale='fr')|capitalize }}</td>
        </tr>
    </table>

    <p style="margin: 0; color: #6B7280; font-size: 14px;">
        Si l'annulation vient de vous, le créneau est de nouveau disponible pour d'autres patients. Sinon, vous pouvez chercher un autre créneau depuis votre espace.
    </p>
{% endblock %}
